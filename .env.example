APP_ENV=local
DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
REDIS_URL=redis://localhost:6379/0

IB_HOST=127.0.0.1
IB_PORT=7497
IB_EXEC_CLIENT_ID=11
IB_MARKET_DATA_CLIENT_ID=12
IB_PNL_CLIENT_ID=13
IB_ACCOUNT=DU0000000
IB_MARKET_DATA_TYPE=1
IB_REQUEST_TIMEOUT_SECONDS=30
IB_PACING_SLEEP_SECONDS=0.25
IB_HEARTBEAT_INTERVAL_SECONDS=15
IB_RECONCILIATION_INTERVAL_SECONDS=60
IB_MIN_SERVER_VERSION=150
IB_ORDER_MESSAGES_PER_SECOND=20
IB_MAX_ORDER_EFFICIENCY_RATIO=20
# 独立日终对账；令牌必须保存在密钥管理系统中。
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
IB_FLEX_TIMEOUT_SECONDS=30
IB_FLEX_MAX_POLL_ATTEMPTS=30

DEFAULT_STRATEGY_CODE=dual-asset-momentum
DEFAULT_CALIBRATION_VERSION=local-dev
SMOKE_SYMBOLS=SPY
SMOKE_DAYS=1
OPTION_DTE_MIN=7
OPTION_DTE_MAX=45
RISK_NOTIONAL_CAP=100000
RISK_DAILY_LOSS_LIMIT=1000
OPTION_SPREAD_PCT_MAX=0.10
ORDER_TTL_SECONDS=90
TRADING_MODE=READ_ONLY
TRADING_ALLOWED_ACCOUNTS=
LIVE_TRADING_ENABLED=false
LIVE_ARM_TTL_SECONDS=300
SERVICE_API_KEYS=
# 实盘要求身份绑定角色；此 JSON 必须由密钥管理系统注入。
# 可用角色包括 read、order_submitter、execution_operator、risk_authorizer、
# risk_proposer、risk_approver、risk_operator 和 reconciler。
# 每个 order_submitter 还必须声明明确的 strategies 列表，例如：
# {"strategy-alpha":{"key":"replace-with-32-random-characters","roles":["read","order_submitter"],"strategies":["alpha"]}}
SERVICE_API_IDENTITIES=
RISK_SYMBOL_NOTIONAL_CAP=150000
RISK_GROSS_NOTIONAL_CAP=500000
RISK_MAX_DAILY_ORDER_COUNT=100
RISK_MAX_DAILY_TRADED_NOTIONAL=250000
RISK_ACCOUNT_SNAPSHOT_MAX_AGE_SECONDS=10
RISK_ACCOUNT_SNAPSHOT_REFRESH_SECONDS=5
RISK_QUOTE_MAX_AGE_SECONDS=5
RISK_PRICE_DEVIATION_PCT_MAX=0.03
RISK_ALLOW_OUTSIDE_RTH=false
RISK_ALLOW_MARKET_CLOSED_ORDERS=false
RISK_ALLOW_OPENING_EQUITY_SHORTS=false
RISK_ALLOW_NAKED_SHORT_OPTIONS=false
RISK_REQUIRE_HALT_STATUS_FOR_LIVE=true
RISK_MINIMUM_SHORTABLE_RATING=2.5
RISK_REQUIRE_ACTIVE_POLICY_FOR_LIVE=true
