APP_ENV=local
DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
REDIS_URL=redis://localhost:6379/0

IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=11
IB_PAPER_PORT=7497
IB_LIVE_PORT=7496
IB_PAPER_ACCOUNT=
IB_LIVE_ACCOUNT=
IB_MARKET_DATA_TYPE=4
IB_REQUEST_TIMEOUT_SECONDS=30
IB_PACING_SLEEP_SECONDS=0.25

DEFAULT_CALIBRATION_VERSION=local-dev
SMOKE_SYMBOLS=SPY
SMOKE_DAYS=1
OPTION_DTE_MIN=7
OPTION_DTE_MAX=45
RISK_NOTIONAL_CAP=100000
RISK_DAILY_LOSS_LIMIT=1000
RISK_GROSS_EXPOSURE_CAP=250000
OPTION_SPREAD_PCT_MAX=0.10
MAX_QUOTE_AGE_SECONDS=30
ORDER_TTL_SECONDS=90

# Live trading is intentionally locked by two independent settings.
ALLOW_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=
